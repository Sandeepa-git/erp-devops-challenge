# VOLTEX ERP - Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your environment.

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=erp_db
DB_PORT=5432

# Backend API Configuration
BACKEND_PORT=5000
NODE_ENV=production
CORS_ORIGIN=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000

# Database Pool Settings (Optional Fine-Tuning)
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONN_TIMEOUT=5000
DB_SSL=false

# Frontend Configuration
FRONTEND_PORT=3000


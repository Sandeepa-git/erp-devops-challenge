# ==============================================================================
# ERP DevOps Arena - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this template to .env:
#      cp .env.example .env
# 2. Adjust credentials and ports as needed for your local environment.
# 3. NEVER commit your actual .env file or sensitive production credentials to Git!
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=erp_db
DB_PORT=5432

# Backend API Configuration
BACKEND_PORT=5000
NODE_ENV=production
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Database Pool Settings (Fine-Tuning)
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONN_TIMEOUT=5000
DB_SSL=false

# Frontend Configuration
FRONTEND_PORT=3000
